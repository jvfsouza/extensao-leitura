{
  "manifest_version": 3,
  "name": "Leitor de Páginas",
  "version": "1.0",
  "description": "Extrai o texto da página e lê em voz alta (TTS), com vozes neurais offline (Piper) em português e inglês.",
  "permissions": ["activeTab", "scripting", "tts", "storage", "offscreen"],
  "host_permissions": ["https://huggingface.co/*", "https://*.hf.co/*", "https://*.huggingface.co/*"],
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Leitor de Páginas",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  }
}
